{
  "name": "stack-in-card",
  "version": "2.0.4",
  "description": "Stack-in-Card for Home Assistant's Lovelace UI — borderless grouping of cards with a visual editor and custom CSS per card.",
  "main": "dist/stack-in-card.js",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c",
    "dev": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,css}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duczz/ha-stack-in-card.git"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "stack",
    "vertical-stack-in-card"
  ],
  "author": "Jérôme Wiedemann <jerome@wnetworks.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/duczz/ha-stack-in-card/issues"
  },
  "homepage": "https://github.com/duczz/ha-stack-in-card#readme",
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-postcss-lit": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2
  }
}
